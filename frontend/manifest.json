{
  "manifest_version": 3,
  "name": "DDAS - Smart Download Watchdog",
  "version": "1.0",
  "description": "Detects duplicate downloads before they complete.",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DDAS"
  }
}
